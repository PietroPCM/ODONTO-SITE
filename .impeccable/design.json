      "html": "<a class=\"ds-dock\" href=\"#\"><span class=\"ds-dock-text\"><span class=\"ds-dock-title\">Conversar no WhatsApp</span><span class=\"ds-dock-meta\">Seg a sex, 8h às 18h</span></span><span class=\"ds-dock-icon\"><svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg></span></a>",
